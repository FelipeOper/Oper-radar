+:root {
+  /* Valores iniciais = tema escuro do design system; applyUiPreferences() sobrescreve em runtime. */
+  --or-bg: #0a0a0a;
+  --or-surface: #141414;
+  --or-surface-2: #1a1a1a;
+  --or-surface-3: #262626;
+  --or-ink: #ffffff;
+  --or-ink-muted: #a3a3a3;
+  --or-signal: #46f84b;
+  --or-positive: #46f84b;
+  --or-alert: #ff6b6b;
+  --or-line: rgba(255, 255, 255, 0.1);
+  --or-line-strong: rgba(255, 255, 255, 0.22);
+  --or-control-min-height: 42px;
+  --or-card-default-padding: 20px;
+}
+html,
+body,
+#root {
+  height: 100%;
+  margin: 0;
+}
+
+body {
+  background: var(--or-bg);
+  color: var(--or-ink);
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+  transition: background-color 180ms ease, color 180ms ease;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+button,
+input,
+select {
+  min-height: var(--or-control-min-height);
+}
+
+button,
+a {
+  -webkit-tap-highlight-color: transparent;
+}
+
+button:focus-visible,
+input:focus-visible,
+select:focus-visible,
+a:focus-visible {
+  outline: 2px solid var(--or-signal);
+  outline-offset: 2px;
+}
+
+/* Pontos de grafico/distribuicao (Painel Mercado) sao focaveis via tabIndex mas nao
+   sao button/input/select/a, entao precisam entrar explicitamente na regra de foco. */
+[tabindex]:focus-visible,
+circle:focus-visible {
+  outline: 2px solid var(--or-signal);
+  outline-offset: 2px;
+}
+
+select {
+  max-width: 100%;
+}
+
+.or-card-density {
+  padding: var(--or-card-default-padding) !important;
+}
+
+.or-route-tools {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-height: 32px;
+  margin-bottom: 10px;
+  color: var(--or-ink-muted);
+  font-size: 11px;
+}
+
+.or-back-button,
+.or-breadcrumb-list button {
+  min-height: 30px;
+  padding: 4px 7px;
+  border: 0;
+  border-radius: 7px;
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  cursor: pointer;
+}
+
+.or-back-button {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  color: var(--or-ink);
+}
+
+.or-back-button:hover,
+.or-breadcrumb-list button:hover {
+  background: var(--or-surface-2);
+  color: var(--or-signal);
+}
+
+.or-breadcrumb-list {
+  display: flex;
+  align-items: center;
+  gap: 3px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.or-breadcrumb-list li {
+  display: inline-flex;
+  align-items: center;
+  gap: 3px;
+  min-width: 0;
+}
+
+.or-breadcrumb-list span {
+  overflow: hidden;
+  max-width: 180px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* Listagens com leitura de planilha: linhas/cards alternam entre os dois
+   tons de superfície do tema, sem depender de cores fixas. */
+.or-zebra-list > :nth-child(odd) {
+  --or-zebra-bg: var(--or-surface);
+}
+
+.or-zebra-list > :nth-child(even) {
+  --or-zebra-bg: var(--or-surface-2);
+}
+
+.or-zebra-list > * {
+  background-color: var(--or-zebra-bg);
+  box-shadow: inset 0 -1px 0 var(--or-line);
+}
+
+.or-zebra-list > .oc-card {
+  border-color: var(--or-line-strong) !important;
+}
+
+.or-zebra-rows > * {
+  padding: 8px 10px;
+  border-radius: 7px;
+}
+
+@media (max-width: 980px) {
+  .or-mercado-grid {
+    grid-template-columns: 1fr !important;
+  }
+}
+
+/* Painel Mercado (redesign) - grades responsivas por CSS, sem depender de um
+   booleano "mobile" calculado em JS. Ver docs/OPER_RADAR_Estrategia_e_Design.md. */
+.or-panorama-grid {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 0;
+}
+.or-panorama-grid .or-kpi {
+  padding: 20px 24px;
+  border-right: 1px solid var(--or-line);
+}
+.or-panorama-grid .or-kpi:last-child {
+  border-right: none;
+}
+@media (max-width: 620px) {
