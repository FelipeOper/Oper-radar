+/* Select no acabamento do .or-input do design system (40px, raio md, surface-2, seta propria).
+   Comportamento nativo preservado: teclado e seletor do celular. */
 select {
   max-width: 100%;
+  appearance: none;
+  -webkit-appearance: none;
+  /* mesma altura dos inputs do app (42px), para alinhar lado a lado */
+  height: var(--or-control-min-height);
+  min-height: var(--or-control-min-height);
+  padding: 0 40px 0 14px;
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--radius-md);
+  background-color: var(--surface-2);
+  background-image:
+    linear-gradient(45deg, transparent 50%, var(--text-secondary) 50%),
+    linear-gradient(135deg, var(--text-secondary) 50%, transparent 50%);
+  background-position: calc(100% - 20px) 50%, calc(100% - 15px) 50%;
+  background-size: 5px 5px, 5px 5px;
+  background-repeat: no-repeat;
+  color: var(--text-primary);
+  font: 500 var(--fs-sm) / 1.2 var(--font-sans);
+  text-overflow: ellipsis;
+  cursor: pointer;
+  transition: border-color var(--dur-fast) var(--ease-out);
+}
+select:hover:not(:disabled) {
+  border-color: var(--border-default);
+}
+select:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+select option {
+  background: var(--surface-1);
+  color: var(--text-primary);
 }
 
