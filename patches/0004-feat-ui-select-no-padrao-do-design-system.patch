-.oc-cmp__select { width: 100%; min-height: 42px; padding: 0 12px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-2); color: var(--text-primary); font: inherit; }
+.oc-cmp__select { width: 100%; }
 .oc-cmp__resultado { display: flex; flex-direction: column; gap: 14px; }
 .oc-cmp__tabela { display: flex; flex-direction: column; gap: 0; padding: 4px 16px; }
 .oc-cmp__linha { display: grid; grid-template-columns: minmax(130px, 1fr) minmax(0, 1.4fr) minmax(0, 1.4fr); gap: 12px; padding: 10px 0; border-top: 1px solid var(--border-subtle); align-items: baseline; overflow-wrap: anywhere; }
