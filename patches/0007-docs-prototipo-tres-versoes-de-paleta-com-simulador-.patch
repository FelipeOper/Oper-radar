diff --git a/prototipos/versoes.html b/prototipos/versoes.html
new file mode 100644
index 0000000..9c0e6ce
--- /dev/null
+++ b/prototipos/versoes.html
@@ -0,0 +1,323 @@
+<!doctype html>
+<html lang="pt-BR">
+<head>
+<meta charset="utf-8" />
+<meta name="viewport" content="width=device-width, initial-scale=1" />
+<title>Oper Radar — versões</title>
+<link rel="stylesheet" href="../design-system/styles.css" />
+<style>
+/* Tres versoes de paleta sobre a MESMA estrutura. So muda o bloco de tokens. */
+:root, [data-v="verde"] {
+  --bg: #0A0A0A; --bg-2: #0F0F0F; --surface: #141414; --surface-2: #1A1A1A; --surface-3: #262626;
+  --line: rgba(255,255,255,.08); --line-2: rgba(255,255,255,.14);
+  --ink: #FFFFFF; --ink-2: #A3A3A3; --ink-3: #6E6E6E;
+  --accent: #46F84B; --accent-2: #7FFB82; --on-accent: #0A0A0A; --accent-soft: rgba(70,248,75,.12);
+  --neutral-bar: rgba(255,255,255,.62); --glow: rgba(70,248,75,.35);
+  --sidebar: #000000; --nav-active-bg: #46F84B; --nav-active-ink: #0A0A0A;
+  --hero-bg: #46F84B; --hero-ink: #0A0A0A; --hero-ink-2: rgba(10,10,10,.68);
+  --down: #FF6B6B;
+}
+[data-v="dourado"] {
+  --bg: #0C0B09; --bg-2: #100E0B; --surface: #15130F; --surface-2: #1B1813; --surface-3: #27231B;
+  --line: rgba(255,226,170,.07); --line-2: rgba(255,226,170,.14);
+  --ink: #F6F1E7; --ink-2: #A69C8A; --ink-3: #6F675A;
+  --accent: #E0B15A; --accent-2: #F0CB82; --on-accent: #1A1206; --accent-soft: rgba(224,177,90,.12);
+  --neutral-bar: rgba(246,241,231,.55); --glow: rgba(224,177,90,.35);
+  --sidebar: #0E0C09; --nav-active-bg: rgba(224,177,90,.14); --nav-active-ink: #F0CB82;
+  --hero-bg: linear-gradient(135deg, #2A2214 0%, #1B1711 100%); --hero-ink: #F6F1E7; --hero-ink-2: #A69C8A;
+  --down: #E8806B;
+}
+[data-v="azul"] {
+  --bg: #090D13; --bg-2: #0B1018; --surface: #0F151F; --surface-2: #141B27; --surface-3: #1D2633;
+  --line: rgba(160,190,255,.08); --line-2: rgba(160,190,255,.15);
+  --ink: #F2F6FC; --ink-2: #93A0B4; --ink-3: #5F6B7D;
+  --accent: #3D86F5; --accent-2: #6EA6FF; --on-accent: #FFFFFF; --accent-soft: rgba(61,134,245,.14);
+  --neutral-bar: rgba(242,246,252,.55); --glow: rgba(61,134,245,.4);
+  --sidebar: #070A0F; --nav-active-bg: rgba(61,134,245,.16); --nav-active-ink: #6EA6FF;
+  --hero-bg: linear-gradient(135deg, #12223D 0%, #0F1726 100%); --hero-ink: #F2F6FC; --hero-ink-2: #93A0B4;
+  --down: #F07A7A;
+}
+
+* { box-sizing: border-box; }
+html, body { margin: 0; height: 100%; }
+body { background: var(--bg); color: var(--ink); font-family: var(--font-sans); -webkit-font-smoothing: antialiased; }
+.num { font-variant-numeric: tabular-nums; }
+
+/* Shell */
+.app { display: grid; grid-template-columns: 248px 1fr; min-height: 100vh; }
+.side { background: var(--sidebar); border-right: 1px solid var(--line); padding: 20px 14px; display: flex; flex-direction: column; gap: 4px; position: sticky; top: 0; height: 100vh; }
+.brand { display: flex; align-items: center; gap: 10px; padding: 4px 8px 22px; }
+.brand-mark { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); border: 1px solid var(--line-2); }
+.brand b { display: block; font-size: 14px; letter-spacing: .01em; }
+.brand small { display: block; font-size: 11px; color: var(--ink-3); }
+.grp { font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); padding: 14px 10px 6px; }
+.nav { display: flex; align-items: center; gap: 10px; height: 38px; padding: 0 10px; border-radius: 10px; color: var(--ink-2); font-size: 13.5px; }
+.nav i { font-size: 17px; }
+.nav.on { background: var(--nav-active-bg); color: var(--nav-active-ink); font-weight: 600; }
+.side-foot { margin-top: auto; border: 1px solid var(--line); border-radius: 14px; padding: 12px; display: flex; gap: 10px; align-items: center; background: var(--surface); }
+.pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); flex: none; }
+.side-foot b { font-size: 12.5px; display: block; }
+.side-foot small { font-size: 11px; color: var(--ink-3); }
+
+.main { min-width: 0; }
+.top { height: 64px; display: flex; align-items: center; gap: 12px; padding: 0 32px; border-bottom: 1px solid var(--line); position: sticky; top: 0; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(12px); z-index: 5; }
+.crumb { font-size: 11.5px; color: var(--ink-3); }
+.top h1 { margin: 0; font-size: 17px; font-weight: 600; }
+.top .sp { flex: 1; }
+.btn { height: 38px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--line-2); background: transparent; color: var(--ink); font: 500 13px/1 var(--font-sans); display: inline-flex; align-items: center; gap: 8px; }
+.btn.pri { background: var(--accent); color: var(--on-accent); border-color: transparent; font-weight: 600; }
+.icon-btn { width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--line-2); display: grid; place-items: center; color: var(--ink-2); }
+
+.content { padding: 28px 32px 96px; max-width: 1440px; }
+.hero-title { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
+.eyebrow { display: inline-flex; height: 26px; align-items: center; padding: 0 12px; border-radius: 999px; border: 1px solid var(--line-2); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 12px; }
+.hero-title h2 { margin: 0; font: 400 34px/1.1 var(--font-display, var(--font-sans)); letter-spacing: -.01em; }
+.hero-title h2 em { font-style: normal; color: var(--accent); }
+.hero-title p { margin: 8px 0 0; color: var(--ink-2); font-size: 13px; }
+.seg { display: inline-flex; padding: 4px; gap: 2px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line); }
+.seg span { height: 30px; padding: 0 14px; border-radius: 999px; display: grid; place-items: center; font-size: 12.5px; color: var(--ink-2); }
+.seg span.on { background: var(--ink); color: var(--bg); font-weight: 600; }
+
+.kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 12px; }
+.card { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 20px; min-width: 0; }
+.kpi .lab { display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; color: var(--ink-2); }
+.kpi .ic { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--surface-3); color: var(--ink-2); font-size: 15px; }
+.kpi .val { font-size: 32px; font-weight: 700; letter-spacing: -.02em; margin: 14px 0 6px; }
+.kpi .sub { font-size: 12px; color: var(--ink-3); }
+.kpi .sub b { color: var(--accent); font-weight: 600; }
+.kpi .sub b.down { color: var(--down); }
+.kpi.hero { background: var(--hero-bg); border-color: transparent; color: var(--hero-ink); }
+[data-v="dourado"] .kpi.hero, [data-v="azul"] .kpi.hero { border-color: var(--line-2); }
+.kpi.hero .lab, .kpi.hero .sub { color: var(--hero-ink-2); }
+.kpi.hero .ic { background: var(--accent); color: var(--on-accent); }
+[data-v="verde"] .kpi.hero .ic { background: #0A0A0A; color: #46F84B; }
+[data-v="verde"] .kpi.hero .sub b { color: #0A0A0A; }
+
+.row { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 12px; margin-bottom: 12px; }
+.card h3 { margin: 0; font-size: 15px; font-weight: 600; }
+.card .h-sub { margin: 4px 0 0; font-size: 12px; color: var(--ink-3); }
+.card-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 18px; }
+.legend { display: flex; gap: 14px; font-size: 11.5px; color: var(--ink-2); }
+.legend i { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; vertical-align: 0; }
+svg.chart { width: 100%; height: 230px; display: block; }
+.bars { display: flex; flex-direction: column; gap: 14px; }
+.bar-top { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--ink-2); margin-bottom: 7px; }
+.bar-top b { color: var(--ink); font-weight: 600; }
+.track { height: 6px; border-radius: 999px; background: var(--surface-3); overflow: hidden; }
+.fill { height: 100%; border-radius: 999px; background: var(--neutral-bar); }
+.fill.top { background: var(--accent); box-shadow: 0 0 12px var(--glow); }
+
+.list { display: flex; flex-direction: column; }
+.li { display: grid; grid-template-columns: 1fr auto auto; gap: 16px; align-items: center; padding: 13px 0; border-top: 1px solid var(--line); font-size: 13px; }
+.li:first-child { border-top: 0; }
+.li small { display: block; color: var(--ink-3); font-size: 11.5px; margin-top: 2px; }
+.li .price { font-weight: 600; }
+.chip { height: 22px; padding: 0 9px; border-radius: 999px; display: inline-flex; align-items: center; font-size: 11px; font-weight: 600; background: var(--surface-3); color: var(--ink-2); }
+.chip.acc { background: var(--accent-soft); color: var(--accent); }
+
+/* Botao flutuante do chat */
+.fab { position: fixed; right: 28px; bottom: 28px; width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--on-accent); font-size: 24px; box-shadow: 0 12px 32px -8px var(--glow); z-index: 20; }
+.fab::after { content: ""; position: absolute; top: 4px; right: 4px; width: 11px; height: 11px; border-radius: 50%; background: var(--ink); border: 2px solid var(--accent); }
+
+/* Painel lateral (simulador / chat) */
+.scrim { position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 30; display: none; }
+.sheet { position: fixed; top: 0; right: 0; bottom: 0; width: 460px; max-width: 100vw; background: var(--bg-2); border-left: 1px solid var(--line-2); z-index: 31; display: none; flex-direction: column; box-shadow: -24px 0 60px rgba(0,0,0,.5); }
+[data-tela="simulador"] .scrim, [data-tela="chat"] .scrim { display: block; }
+[data-tela="simulador"] #sim, [data-tela="chat"] #chat { display: flex; }
+[data-tela="chat"] .fab, [data-tela="simulador"] .fab { display: none; }
+.sh-head { padding: 22px 24px 16px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; gap: 12px; }
+.sh-head h4 { margin: 0; font-size: 17px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
+.sh-head h4 i { color: var(--accent); }
+.sh-head p { margin: 6px 0 0; font-size: 12.5px; color: var(--ink-2); line-height: 1.5; }
+.sh-body { padding: 20px 24px; overflow: auto; flex: 1; display: flex; flex-direction: column; gap: 18px; }
+.form { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
+.f label { display: block; font-size: 12px; color: var(--ink-2); margin-bottom: 6px; }
+.f div { height: 42px; border-radius: 14px; background: var(--surface-2); border: 1px solid var(--line); display: flex; align-items: center; padding: 0 14px; font-size: 13.5px; }
+.prices { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
+.pc { border-radius: 16px; padding: 14px; background: var(--surface); border: 1px solid var(--line); }
+.pc span { font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
+.pc b { display: block; font-size: 18px; margin-top: 6px; letter-spacing: -.01em; }
+.pc.main { background: var(--accent-soft); border-color: color-mix(in srgb, var(--accent) 40%, transparent); }
+.pc.main b { color: var(--accent); }
+.facts { display: flex; flex-wrap: wrap; gap: 8px 14px; font-size: 12px; color: var(--ink-2); }
+.facts b { color: var(--ink); font-weight: 600; }
+.best { border-radius: 16px; padding: 14px 16px; background: var(--surface); border: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; font-size: 13px; }
+.best b { font-size: 16px; }
+table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
+th { text-align: left; font-weight: 500; color: var(--ink-3); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; padding: 0 0 8px; }
+td { padding: 10px 0; border-top: 1px solid var(--line); }
+th:not(:first-child), td:not(:first-child) { text-align: right; }
+tr.hl td { color: var(--accent); font-weight: 600; }
+.note { font-size: 11.5px; color: var(--ink-3); line-height: 1.5; }
+
+.tabs2 { display: flex; gap: 4px; padding: 0 24px 0; margin-top: 14px; }
+.tabs2 span { height: 32px; padding: 0 14px; border-radius: 999px; display: grid; place-items: center; font-size: 12.5px; color: var(--ink-2); }
+.tabs2 span.on { background: var(--ink); color: var(--bg); font-weight: 600; }
+.msg { max-width: 88%; padding: 12px 14px; border-radius: 16px; font-size: 13px; line-height: 1.55; }
+.msg.u { align-self: flex-end; background: var(--surface-3); border-bottom-right-radius: 6px; }
+.msg.a { align-self: flex-start; background: var(--surface); border: 1px solid var(--line); border-bottom-left-radius: 6px; }
+.msg.a b { color: var(--accent); }
+.msg .src { display: block; margin-top: 8px; font-size: 11px; color: var(--ink-3); }
+.sugs { display: flex; flex-wrap: wrap; gap: 6px; }
+.sugs span { height: 30px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--line-2); display: grid; place-items: center; font-size: 12px; color: var(--ink-2); }
+.composer { padding: 14px 24px 22px; border-top: 1px solid var(--line); display: flex; gap: 8px; }
+.composer div { flex: 1; height: 44px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line); display: flex; align-items: center; padding: 0 16px; font-size: 13px; color: var(--ink-3); }
+.composer span { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--on-accent); font-size: 18px; }
+
+.demo-tag { position: fixed; left: 50%; bottom: 10px; transform: translateX(-50%); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); z-index: 40; }
+
+/* Mobile */
+.mtop, .mnav { display: none; }
+@media (max-width: 700px) {
+  .app { grid-template-columns: 1fr; }
+  .side, .top { display: none; }
+  .mtop { display: flex; align-items: center; gap: 10px; height: 60px; padding: 0 16px; border-bottom: 1px solid var(--line); position: sticky; top: 0; background: var(--bg); z-index: 5; }
+  .mtop b { font-size: 16px; flex: 1; }
+  .content { padding: 20px 16px 120px; }
+  .hero-title { flex-direction: column; align-items: flex-start; }
+  .hero-title h2 { font-size: 27px; }
+  .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
+  .card { padding: 16px; border-radius: 18px; }
+  .kpi .val { font-size: 25px; margin: 10px 0 4px; }
+  .kpi .lab span:first-child { max-width: 90px; }
+  .row { grid-template-columns: 1fr; }
+  svg.chart { height: 160px; }
+  .mnav { display: grid; grid-template-columns: repeat(5, 1fr); position: fixed; left: 0; right: 0; bottom: 0; height: 76px; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(12px); border-top: 1px solid var(--line); z-index: 10; padding-top: 8px; }
+  .mnav a { display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 10.5px; color: var(--ink-2); }
+  .mnav a i { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font-size: 18px; background: var(--surface); }
+  .mnav a.on { color: var(--ink); font-weight: 600; }
+  .mnav a.on i { background: var(--nav-active-bg); color: var(--nav-active-ink); }
+  [data-v="verde"] .mnav a.on i { background: var(--accent); color: var(--on-accent); }
+  .fab { right: 16px; bottom: 92px; width: 52px; height: 52px; }
+  .sheet { width: 100vw; }
+  .demo-tag { top: 64px; bottom: auto; }
+  .card-head { flex-direction: column; gap: 10px; }
+}
+</style>
+</head>
+<body>
+<div class="app">
+  <aside class="side">
+    <div class="brand"><span class="brand-mark"><img src="../design-system/assets/mark-dark.png" alt="" style="width:22px;height:22px;object-fit:contain"></span><span><b>OPER RADAR</b><small>Inteligência de pesados</small></span></div>
+    <div class="grp">Inteligência</div>
+    <a class="nav on"><i class="ph ph-broadcast"></i>Hoje</a>
+    <a class="nav"><i class="ph ph-chart-bar"></i>Mercado</a>
+    <a class="nav"><i class="ph ph-scales"></i>Comparador</a>
