-@media (max-width: 900px) { .oc-analise-blocos { grid-template-columns: minmax(0, 1fr); } }
+@media (max-width: 1180px) { .oc-analise-blocos { grid-template-columns: minmax(0, 1fr); } }
 
 /* Topbar do celular: so o ponto pulsante (texto completo no aria-label/title), como no UI kit.
    Na sidebar do desktop o texto continua visivel. */
@@ -1146,3 +1149,14 @@ select option {
 /* Mercado: linha de "Onde ha mais ofertas". No celular o nome divide espaco com a barra. */
 .oc-oferta-linha { display: grid; grid-template-columns: minmax(140px, 220px) 1fr 56px; }
 @media (max-width: 560px) { .oc-oferta-linha { grid-template-columns: minmax(0, 1fr) 96px 44px; } }
+
+/* Barra neutra dos rankings: um tom por tema, contraste >= 2:1 com o destaque (sem color-mix). */
+:root { --or-bar-neutral: rgba(255,255,255,.40); }
+[data-theme="dourado"] { --or-bar-neutral: rgba(246,241,231,.38); }
+[data-theme="azul"] { --or-bar-neutral: rgba(242,246,252,.26); }
+[data-theme="light"] { --or-bar-neutral: rgba(15,15,15,.22); }
+
+/* KPI no celular: depois da regra geral (overflow-wrap: anywhere), para o numero nao quebrar nos digitos. */
+@media (max-width: 640px) {
+  .or-panorama-cards .or-stat__value, .oc-hoje__kpis .or-stat__value { overflow-wrap: normal; }
+}
