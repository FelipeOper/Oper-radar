+  align-items: center;
+  gap: 6px;
+  margin: 0;
+  color: var(--text-tertiary);
+  font-size: 12px;
+}
+.oc-alerta-lista {
+  margin: 6px 0 0;
+  padding-left: 18px;
+  font-size: 13px;
+}
+.oc-feed,
+.oc-insights {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  max-height: 520px;
+  overflow-y: auto;
+}
+.oc-feed__item {
