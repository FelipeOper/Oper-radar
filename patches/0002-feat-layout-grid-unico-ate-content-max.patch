+.oc-login__titulo p {
+  margin: 0;
+  color: var(--text-secondary);
+  line-height: 1.55;
+}
+.oc-login__form {
+  display: grid;
+  gap: 18px;
+}
+.oc-login__form .or-input input {
+  width: 100%;
+}
+.oc-login__rodape {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin: 32px 0 0;
+  padding-top: 18px;
+  border-top: 1px solid var(--border-subtle);
+  color: var(--text-tertiary);
+  font-size: 12px;
+}
+@media (max-width: 850px) {
+  .oc-login {
+    display: block;
+  }
+  .oc-login__marca {
+    display: none;
+  }
+  .oc-login__painel {
+    align-items: flex-start;
+    min-height: 100vh;
+    padding: 40px 20px;
+  }
+  .oc-login__caixa {
+    margin: auto;
+  }
+  .oc-login__logo-mobile {
+    display: block;
+  }
+  .oc-login__titulo h1 {
+    font-size: 34px;
+  }
+}
+.oc-conc__segmento { display:flex; flex-direction:column; gap:8px; margin-top:12px; }
+.oc-conc__dica { align-self:center; }
+.oc-conc__segmento > .or-sectiontag { align-self:flex-start; }
+.oc-conc__field { display:flex; flex-direction:column; gap:6px; flex:1 1 220px; min-width:0; }
+.oc-conc__field--busca { flex:2 1 260px; }
+.oc-conc__field > span:first-child { font-size:var(--fs-sm); color:var(--text-secondary); }
+.oc-conc__input { display:flex; align-items:center; gap:8px; min-height:42px; padding:0 12px; background:var(--surface-2); border:1px solid var(--border-subtle); border-radius:var(--radius-md); }
+.oc-conc__input input { width:100%; min-width:0; border:0; background:transparent; color:var(--text-primary); font:inherit; outline:none; }
+.oc-conc__input:focus-within { border-color:var(--accent); }
+.oc-conc__controls { align-items:flex-end; }
+.oc-conc__vazio { text-align:center; padding:var(--space-6); }
+.or-tag:disabled { opacity:.45; cursor:not-allowed; }
+.or-card--accent .oc-evidencia__botao { color: inherit; opacity: .8; }
+.or-card--accent .oc-evidencia__botao:hover { background: rgba(0,0,0,.12); color: inherit; opacity: 1; }
+/* Duas colunas por padrao; quatro so quando a area de conteudo comporta (viewport >= 1180 px, ja descontada a sidebar). */
+.or-panorama-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
+@media (min-width: 1180px) { .or-panorama-cards { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
+@media (max-width: 420px) { .or-panorama-cards { grid-template-columns: minmax(0, 1fr); } }
+.or-panorama-cards .or-stat__value, .oc-kpi .or-stat__value { white-space: normal; overflow-wrap: anywhere; }
+
+/* Minha Loja: resumo de posição e cartões dos veículos próprios. */
+.oc-loja__resumo { display: flex; flex-direction: column; gap: 12px; margin-top: 12px; }
+.oc-loja__grade { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 12px; }
+.oc-loja__cartao { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
+.oc-loja__topo, .oc-loja__linha-preco, .oc-loja__rodape { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
+.oc-loja__controles { display: flex; align-items: center; gap: 6px; }
+.oc-loja__status { min-height: 32px; padding: 0 8px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-2); color: var(--text-primary); font: inherit; font-size: 12px; }
+.oc-loja__dados { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
+.oc-loja__dado { display: flex; flex-direction: column; gap: 2px; min-width: 0; overflow-wrap: anywhere; }
+.oc-loja__preco { font: var(--type-kpi); }
+
+/* Comparador: seletores dos dois lados, tabela lado a lado e diferenças de movimento. */
+.oc-cmp { display: flex; flex-direction: column; gap: 16px; }
+.oc-cmp__lados { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 12px; }
+.oc-cmp__lado { display: flex; flex-direction: column; gap: 12px; }
+.oc-cmp__modos { display: flex; flex-wrap: wrap; gap: 6px; }
+.oc-cmp__modo { min-height: 34px; padding: 0 12px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-1); color: var(--text-secondary); font: inherit; font-size: 12px; cursor: pointer; }
+.oc-cmp__modo.is-on { border-color: var(--accent); color: var(--text-accent); background: var(--accent-soft); }
+.oc-cmp__campos { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: 10px; }
+.oc-cmp__select { width: 100%; min-height: 42px; padding: 0 12px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-2); color: var(--text-primary); font: inherit; }
+.oc-cmp__resultado { display: flex; flex-direction: column; gap: 14px; }
+.oc-cmp__tabela { display: flex; flex-direction: column; gap: 0; padding: 4px 16px; }
+.oc-cmp__linha { display: grid; grid-template-columns: minmax(130px, 1fr) minmax(0, 1.4fr) minmax(0, 1.4fr); gap: 12px; padding: 10px 0; border-top: 1px solid var(--border-subtle); align-items: baseline; overflow-wrap: anywhere; }
+.oc-cmp__linha--cab { border-top: 0; }
+.oc-cmp__rotulo { color: var(--text-secondary); font-size: var(--fs-sm, 13px); }
+.oc-cmp__difs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 12px; }
+.oc-cmp__evidencias { display: flex; flex-wrap: wrap; gap: 16px; }
+@media (max-width: 560px) { .oc-cmp__linha { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } .oc-cmp__linha > .oc-cmp__rotulo { grid-column: 1 / -1; } .oc-cmp__linha--cab > .oc-cmp__rotulo { display: none; } }
+
+/* "O que comprar" por região (Oportunidades): cartão por modelo e lista de anúncios candidatos. */
+.oc-compra { display: flex; flex-direction: column; gap: 14px; }
+.oc-compra__ufs { display: flex; flex-wrap: wrap; gap: 6px; }
+.oc-compra__modelo { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
+.oc-compra__modelo-topo, .oc-compra__anuncio-topo { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
+.oc-compra__indice { display: flex; flex-wrap: wrap; gap: 6px; }
+.oc-compra__lista { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; list-style: none; }
+.oc-compra__anuncio { display: flex; flex-direction: column; gap: 8px; padding: 12px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-1); min-width: 0; }
+.oc-compra__titulo { display: block; overflow-wrap: anywhere; }
+.oc-compra__preco { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
+.oc-compra__selos, .oc-compra__acoes { display: flex; flex-wrap: wrap; gap: 6px; }
+.oc-compra__comp summary { cursor: pointer; color: var(--text-secondary); font-size: var(--fs-sm, 13px); }
+.oc-compra__comp ul { margin: 8px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }
+.oc-compra__comp li { display: flex; justify-content: space-between; gap: 12px; font-size: var(--fs-sm, 13px); }
+@media (max-width: 560px) { .oc-compra__preco { align-items: flex-start; } }
+
+/* Mobile (T02): alvos de toque >= 44 px so em Oportunidades. Escopo em .oc-compra para nao alterar o Comparador (que
+   compartilha .oc-cmp__modo) nem o botao de evidencia das outras telas; o padrao global fica para a T04. */
+@media (max-width: 760px) {
+  .oc-compra__ufs .oc-cmp__modo,
+  .oc-compra .oc-evidencia__botao,
+  .oc-compra .or-btn { min-height: var(--hit-min); }
+  /* padding em vez de display:flex, que esconderia o marcador do <details>. */
+  .oc-compra__comp summary { padding-block: 13px; }
+}
+
+/* Plano de ação: formulário de nova ação e listas de pendentes/concluídas. */
+.oc-acoes { display: flex; flex-direction: column; gap: 16px; }
+.oc-acoes__form { display: grid; grid-template-columns: 2fr 1fr; gap: 12px; align-items: end; }
+.oc-acoes__form-acao { display: flex; align-items: center; gap: 10px; grid-column: 1 / -1; }
+.oc-acoes__grupos { display: flex; flex-direction: column; gap: 20px; }
+.oc-acoes__grupo { display: flex; flex-direction: column; gap: 10px; }
+.oc-acoes__lista { display: flex; flex-direction: column; gap: 8px; margin: 0; padding: 0; list-style: none; }
+.oc-acoes__item { display: flex; flex-direction: column; gap: 8px; padding: 12px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-1); min-width: 0; }
+.oc-acoes__check { align-items: flex-start; }
+.oc-acoes__titulo { overflow-wrap: anywhere; }
+.oc-acoes__titulo.is-done { text-decoration: line-through; color: var(--text-tertiary); }
+.oc-acoes__meta { display: flex; flex-direction: column; gap: 8px; padding-left: 28px; }
+.oc-acoes__evidencia { margin: 0; overflow-wrap: anywhere; }
+.oc-acoes__acoes { display: flex; flex-wrap: wrap; gap: 6px; }
+@media (max-width: 560px) { .oc-acoes__form { grid-template-columns: 1fr; } }
+
+/* Grid unico: o conteudo ocupa a area util inteira, ate --content-max (design-system/tokens/spacing.css). */
+.oc-main > * { max-width: var(--content-max); }
+.oc-lede { max-width: 72ch; color: var(--text-secondary); font-size: var(--fs-sm); line-height: 1.6; }
