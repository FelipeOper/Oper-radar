+:root {
+  /* Valores iniciais = tema escuro do design system; applyUiPreferences() sobrescreve em runtime. */
+  --or-bg: #0a0a0a;
+  --or-surface: #141414;
+  --or-surface-2: #1a1a1a;
+  --or-surface-3: #262626;
+  --or-ink: #ffffff;
+  --or-ink-muted: #a3a3a3;
+  --or-signal: #46f84b;
+  --or-positive: #46f84b;
+  --or-alert: #ff6b6b;
+  --or-line: rgba(255, 255, 255, 0.1);
+  --or-line-strong: rgba(255, 255, 255, 0.22);
+  --or-control-min-height: 42px;
+  --or-card-default-padding: 20px;
+}
+html,
+body,
+#root {
+  height: 100%;
+  margin: 0;
+}
+
+body {
+  background: var(--or-bg);
+  color: var(--or-ink);
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+  transition: background-color 180ms ease, color 180ms ease;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+button,
+input,
+select {
+  min-height: var(--or-control-min-height);
+}
+
+button,
+a {
+  -webkit-tap-highlight-color: transparent;
+}
+
+button:focus-visible,
+input:focus-visible,
+select:focus-visible,
+a:focus-visible {
+  outline: 2px solid var(--or-signal);
+  outline-offset: 2px;
+}
+
+/* Pontos de grafico/distribuicao (Painel Mercado) sao focaveis via tabIndex mas nao
+   sao button/input/select/a, entao precisam entrar explicitamente na regra de foco. */
+[tabindex]:focus-visible,
+circle:focus-visible {
+  outline: 2px solid var(--or-signal);
+  outline-offset: 2px;
+}
+
+select {
+  max-width: 100%;
+}
+
+.or-card-density {
+  padding: var(--or-card-default-padding) !important;
+}
+
+.or-route-tools {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-height: 32px;
+  margin-bottom: 10px;
+  color: var(--or-ink-muted);
+  font-size: 11px;
+}
+
+.or-back-button,
+.or-breadcrumb-list button {
+  min-height: 30px;
+  padding: 4px 7px;
+  border: 0;
+  border-radius: 7px;
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  cursor: pointer;
+}
+
+.or-back-button {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  color: var(--or-ink);
+}
+
+.or-back-button:hover,
+.or-breadcrumb-list button:hover {
+  background: var(--or-surface-2);
+  color: var(--or-signal);
+}
+
+.or-breadcrumb-list {
+  display: flex;
+  align-items: center;
+  gap: 3px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.or-breadcrumb-list li {
+  display: inline-flex;
+  align-items: center;
+  gap: 3px;
+  min-width: 0;
+}
+
+.or-breadcrumb-list span {
+  overflow: hidden;
+  max-width: 180px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* Listagens com leitura de planilha: linhas/cards alternam entre os dois
+   tons de superfície do tema, sem depender de cores fixas. */
+.or-zebra-list > :nth-child(odd) {
+  --or-zebra-bg: var(--or-surface);
+}
+
+.or-zebra-list > :nth-child(even) {
+  --or-zebra-bg: var(--or-surface-2);
+}
+
+.or-zebra-list > * {
+  background-color: var(--or-zebra-bg);
+  box-shadow: inset 0 -1px 0 var(--or-line);
+}
+
+.or-zebra-list > .oc-card {
+  border-color: var(--or-line-strong) !important;
+}
+
+.or-zebra-rows > * {
+  padding: 8px 10px;
+  border-radius: 7px;
+}
+
+@media (max-width: 980px) {
+  .or-mercado-grid {
+    grid-template-columns: 1fr !important;
+  }
+}
+
+/* Painel Mercado (redesign) - grades responsivas por CSS, sem depender de um
+   booleano "mobile" calculado em JS. Ver docs/OPER_RADAR_Estrategia_e_Design.md. */
+.or-panorama-grid {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 0;
+}
+.or-panorama-grid .or-kpi {
+  padding: 20px 24px;
+  border-right: 1px solid var(--or-line);
+}
+.or-panorama-grid .or-kpi:last-child {
+  border-right: none;
+}
+@media (max-width: 620px) {
+  .or-panorama-grid .or-kpi {
+    border-bottom: 1px solid var(--or-line);
+  }
+  .or-panorama-grid .or-kpi:nth-child(2n) {
+    border-right: none;
+  }
+}
+@media (max-width: 620px) {
+  .or-panorama-grid {
+    grid-template-columns: repeat(2, 1fr);
+  }
+}
+
+.or-models-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
+  gap: 10px;
+}
+@media (max-width: 560px) {
+  .or-models-grid {
+    grid-template-columns: 1fr;
+  }
+}
+
+.or-refine-btn {
+  margin-left: auto;
+}
+@media (max-width: 560px) {
+  .or-refine-btn {
+    margin-left: 0;
+    width: 100%;
+  }
+}
+
+:root[data-density='compact'] {
+  --or-control-min-height: 38px;
+  --or-card-default-padding: 15px;
+}
+
+:root[data-density='comfortable'] {
+  --or-control-min-height: 46px;
+  --or-card-default-padding: 24px;
+}
+
+::-webkit-scrollbar {
+  width: 10px;
+  height: 10px;
+}
+
+::-webkit-scrollbar-thumb {
+  background: var(--or-line-strong);
+  border-radius: 5px;
+}
+
+::-webkit-scrollbar-track {
+  background: transparent;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation: none !important;
+    scroll-behavior: auto !important;
+    transition: none !important;
+  }
+}
+
+:root[data-reduce-motion='true'] *,
+:root[data-reduce-motion='true'] *::before,
+:root[data-reduce-motion='true'] *::after {
+  animation: none !important;
+  scroll-behavior: auto !important;
+  transition: none !important;
+}
+
+/* Concorrencia: filtros, indicadores e painel responsivos do design system. */
+.oc-conc { display:flex; flex-direction:column; gap:16px; }
+.oc-conc__chips { display:flex; gap:8px; flex-wrap:wrap; }
+.oc-conc__controls { display:flex; gap:10px; flex-wrap:wrap; }
+.oc-conc__controls label.oc-conc__legacy { display:flex; align-items:center; gap:8px; flex:1 1 240px; padding:0 12px; background:var(--surface-2); border:1px solid var(--border-subtle); border-radius:var(--radius-md); }
+.oc-conc__controls input { width:100%; min-width:0; border:0; background:transparent; color:var(--text-primary); font:inherit; }
+.oc-conc__controls select,.oc-conc__sort select { min-height:42px; padding:0 12px; border:1px solid var(--border-subtle); border-radius:var(--radius-md); background:var(--surface-2); color:var(--text-primary); font:inherit; }
+.oc-conc__controls select { flex:none; width:100%; }
+.oc-conc__metrics { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,190px),1fr)); gap:10px; }
+.oc-conc__metrica { gap:8px; }
+.oc-conc__metrica .or-stat__value { font:var(--type-kpi); white-space:normal; overflow-wrap:anywhere; }
+.oc-conc__rows { display:flex; flex-direction:column; gap:8px; }
+.oc-conc__row { min-height:78px; }
+.oc-conc__row .or-listrow__s { display:flex; align-items:center; gap:4px; white-space:normal; }
+.oc-conc__backdrop { position:fixed; inset:0; z-index:1000; display:flex; justify-content:flex-end; background:rgba(0,0,0,.65); }
+.oc-conc__panel { width:min(760px,100vw); height:100%; overflow-y:auto; background:var(--or-bg); color:var(--text-primary); border-left:1px solid var(--border-subtle); box-shadow:0 0 30px rgba(0,0,0,.25); }
+.oc-conc__panelhead { position:sticky; top:0; z-index:2; display:flex; justify-content:space-between; align-items:flex-start; gap:12px; padding:20px; background:var(--or-bg); border-bottom:1px solid var(--border-subtle); }
+.oc-conc__panelhead h2 { margin:4px 0; font:var(--type-page-title); }
+.oc-conc__panelhead p { margin:0; color:var(--text-tertiary); }
+.oc-conc__eyebrow { color:var(--accent); font-size:11px; font-weight:700; letter-spacing:.08em; }
+.oc-conc__panelbody { display:flex; flex-direction:column; gap:14px; padding:20px; }
+.oc-conc__sort { display:flex; align-items:center; gap:10px; flex-wrap:wrap; color:var(--text-secondary); font-size:13px; }
+@media(max-width:600px) { .oc-conc__panelhead,.oc-conc__panelbody { padding:14px; } .oc-conc__row .or-listrow__lead { display:none; } .oc-conc__row { padding:12px; } }
+
+@media (max-width: 760px) {
+  :root {
+    --or-control-min-height: 44px;
+  }
+
+  ::-webkit-scrollbar {
+    width: 4px;
+    height: 4px;
+  }
+
+  .or-route-tools {
+    gap: 6px;
+    overflow: hidden;
+  }
+
+  .or-breadcrumb-list span {
+    max-width: 96px;
+  }
+}
+
+/* ---- Casca do app (Shell.jsx): sidebar, topbar e barra inferior do design system ---- */
+.oc-shell {
+  display: flex;
+  height: 100%;
+  overflow: hidden;
+  background: var(--or-bg);
+  color: var(--or-ink);
+}
+.oc-shell__col {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  min-width: 0;
+}
+.oc-main {
+  flex: 1;
+  overflow-y: auto;
+  padding: 24px var(--gutter) 48px;
+}
+.oc-sidebar {
+  flex: none;
+}
+.oc-sidebar .or-navitem,
+.oc-sheet .or-navitem {
+  min-height: 44px;
+}
+.oc-mark-light,
+[data-theme='light'] .oc-mark-dark {
+  display: none;
+}
+[data-theme='light'] .oc-mark-light {
+  display: inline;
+}
+.oc-user {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  width: 100%;
+  min-height: 48px;
+  padding: 8px 10px;
+  border: 0;
+  border-radius: var(--radius-lg);
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  text-align: left;
+  cursor: pointer;
+}
+.oc-user:hover {
+  background: var(--surface-2);
+}
+.oc-user__avatar {
+  display: grid;
+  flex: none;
+  width: 32px;
+  height: 32px;
+  place-items: center;
+  border-radius: 50%;
+  background: var(--surface-3);
+  color: var(--accent);
+}
+.oc-user__text {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+}
+.oc-user__text strong,
+.oc-user__text small {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.oc-user__text strong {
+  font-size: 13px;
+}
+.oc-user__text small {
+  color: var(--text-tertiary);
+  font-size: 11px;
+}
+.oc-topbar-status {
+  display: none;
+}
+.oc-bottomnav,
+.oc-sheet,
+.oc-sheet-backdrop {
+  display: none;
+}
+.or-topbar__crumb .or-breadcrumb-list button {
+  min-height: 24px;
+  padding: 2px 4px;
+}
+.oc-dot {
+  position: absolute;
+  top: 8px;
+  right: 8px;
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--danger);
+}
+.or-bottomnav__ic {
+  position: relative;
+}
+.or-bottomnav__item {
+  min-height: 60px;
+}
+
+@media (max-width: 899px) {
+  .oc-sidebar {
+    display: none;
+  }
+  .oc-main {
+    padding: 16px var(--gutter-mobile) calc(var(--bottomnav-h) + 24px);
+  }
+  .oc-topbar-status {
+    display: inline-flex;
+  }
+  .oc-bottomnav {
+    position: fixed;
+    right: 0;
+    bottom: 0;
+    left: 0;
+    z-index: var(--z-topbar);
+    display: flex;
+    background: var(--or-nav);
+  }
+  .oc-sheet-backdrop {
+    position: fixed;
+    inset: 0;
+    z-index: calc(var(--z-topbar) + 1);
+    display: block;
+    background: var(--or-overlay);
+  }
+  .oc-sheet {
+    position: fixed;
+    right: 12px;
+    bottom: calc(var(--bottomnav-h) + 12px + env(safe-area-inset-bottom));
+    left: 12px;
+    z-index: calc(var(--z-topbar) + 2);
+    display: flex;
+    flex-direction: column;
+    gap: 4px;
+    padding: 10px;
+    border: 1px solid var(--border-default);
+    border-radius: var(--radius-lg);
+    background: var(--surface-1);
+    box-shadow: var(--or-shadow);
+  }
+}
+
+@media (max-width: 640px) {
+  .or-topbar__crumb {
+    display: none;
+  }
+}
+
+/* O titulo recebe foco por codigo a cada troca de tela (leitor de tela); nao e um controle, sem anel visual. */
+.or-topbar__h:focus,
+.or-topbar__h:focus-visible {
+  outline: none;
+  box-shadow: none;
+}
+
+/* ---- Tela Hoje (HojeBlocos.jsx / Evidencia.jsx) ---- */
+.oc-hoje {
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+}
+.oc-hoje__topo {
