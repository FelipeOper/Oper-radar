From 5919ac68b897f1177e1b6e5964750682a9bdff9d Mon Sep 17 00:00:00 2001
From: Felipe Hilario <felipehilarioneo@gmail.com>
Date: Sat, 17 Oct 2026 07:27:03 -0300
Subject: [PATCH 12/16] feat(mobile): kpis em 2x2

---
 app/src/theme.css                        |   8 +++++++-
 evidence/depois-fase3/390-analise.png    | Bin 0 -> 54653 bytes
 evidence/depois-fase3/390-hoje.png       | Bin 0 -> 64984 bytes
 evidence/depois-fase3/390-mercado.png    | Bin 0 -> 58409 bytes
 evidence/depois-fase3/390-minha-loja.png | Bin 0 -> 63570 bytes
 5 files changed, 7 insertions(+), 1 deletion(-)
 create mode 100644 evidence/depois-fase3/390-analise.png
 create mode 100644 evidence/depois-fase3/390-hoje.png
 create mode 100644 evidence/depois-fase3/390-mercado.png
 create mode 100644 evidence/depois-fase3/390-minha-loja.png

diff --git a/app/src/theme.css b/app/src/theme.css
index aeefa77..2c1089e 100644
--- a/app/src/theme.css
+++ b/app/src/theme.css
@@ -969,7 +969,13 @@ select option {
 /* Duas colunas por padrao; quatro so quando a area de conteudo comporta (viewport >= 1180 px, ja descontada a sidebar). */
 .or-panorama-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
 @media (min-width: 1180px) { .or-panorama-cards { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
-@media (max-width: 420px) { .or-panorama-cards { grid-template-columns: minmax(0, 1fr); } }
+/* Mobile: KPIs em 2 x 2, como no UI kit do design system (reference/ui-kit-admin/mobile.html). */
+@media (max-width: 640px) {
+  .or-panorama-cards, .oc-hoje__kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
+  .or-panorama-cards .or-stat, .oc-hoje__kpis .or-stat { padding: var(--space-4); }
+  .or-panorama-cards .or-stat__value, .oc-hoje__kpis .or-stat__value { font-size: var(--fs-kpi-sm); overflow-wrap: normal; }
+}
+@media (max-width: 359px) { .or-panorama-cards, .oc-hoje__kpis { grid-template-columns: minmax(0, 1fr); } }
 .or-panorama-cards .or-stat__value, .oc-kpi .or-stat__value { white-space: normal; overflow-wrap: anywhere; }
 
 /* Minha Loja: resumo de posição e cartões dos veículos próprios. */
