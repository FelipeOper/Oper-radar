+  --border-focus: #3D86F5;
+  --text-primary: #F2F6FC; --text-secondary: #93A0B4; --text-tertiary: #6B7789; --text-disabled: #3F4958;
+  --text-inverse: #0F151F; --text-on-accent: #FFFFFF; --text-accent: #6EA6FF; --text-link: #6EA6FF;
+  --accent: #3D86F5; --accent-hover: #6EA6FF; --accent-press: #2F6FD6;
+  --accent-soft: rgba(61,134,245,.14); --accent-soft-strong: rgba(61,134,245,.22);
+  --success: #4CC38A; --success-soft: rgba(76,195,138,.12); --success-text: #4CC38A;
+  --chart-1: #3D86F5; --chart-2: #F2F6FC; --chart-grid: rgba(160,190,255,.06);
+  --or-hero-bg: linear-gradient(135deg, #12223D 0%, #0F1726 100%);
+}
+/* Heroi e item ativo: no verde o acento e solido (assinatura do design system);
+   no dourado e no azul o acento solido cansaria, entao vira superficie escura + acento pontual. */
+[data-theme="dourado"] .or-card--accent, [data-theme="azul"] .or-card--accent {
+  background: var(--or-hero-bg); color: var(--text-primary); border-color: var(--border-strong);
+}
+[data-theme="dourado"] .or-card--accent .or-stat__ic, [data-theme="azul"] .or-card--accent .or-stat__ic {
+  background: var(--accent); color: var(--text-on-accent);
+}
+[data-theme="dourado"] .or-card--accent .or-stat__delta, [data-theme="azul"] .or-card--accent .or-stat__delta { color: var(--accent); }
+[data-theme="dourado"] .or-navitem--active, [data-theme="dourado"] .or-navitem--active:hover,
+[data-theme="azul"] .or-navitem--active, [data-theme="azul"] .or-navitem--active:hover {
+  background: var(--accent-soft); color: var(--accent-hover); box-shadow: inset 0 0 0 1px var(--accent-soft-strong);
+}
+[data-theme="dourado"] .or-bottomnav__item--active .or-bottomnav__ic, [data-theme="azul"] .or-bottomnav__item--active .or-bottomnav__ic {
+  background: var(--accent-soft); color: var(--accent-hover);
+}
