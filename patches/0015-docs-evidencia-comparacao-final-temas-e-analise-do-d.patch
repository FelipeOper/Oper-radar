    <div style="aspect-ratio:${mobile ? "390/844" : "1440/900"};overflow:hidden;border-radius:8px;border:1px solid #444"><img src="${uri(`${d}/${n}.png`)}" style="width:100%;display:block"></div></div>`).join('')}
   </div></body></html>`);
