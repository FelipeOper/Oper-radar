# Cobertura nacional sem PR, fora dos horarios do coletor dedicado do PR.
# Ajuste apenas SEUUSUARIO antes de instalar.

0 8 * * * set -a; . /home1/SEUUSUARIO/.oper-radar.env; set +a; cd /home1/SEUUSUARIO/agenciaoper.com.br/oper-radar/fase1-coleta && "${OPER_RADAR_PYTHON:-python3}" coleta_multi_uf.py --plano=nacional --janela=07h >> /home1/SEUUSUARIO/logs/coleta-expansao.log 2>&1
0 20 * * * set -a; . /home1/SEUUSUARIO/.oper-radar.env; set +a; cd /home1/SEUUSUARIO/agenciaoper.com.br/oper-radar/fase1-coleta && "${OPER_RADAR_PYTHON:-python3}" coleta_multi_uf.py --plano=nacional --janela=19h >> /home1/SEUUSUARIO/logs/coleta-expansao.log 2>&1
